{
  "name": "VCL Channel Config",
  "module": "VCL Messaging",
  "doctype": "DocType",
  "document_type": "Setup",
  "editable_grid": 1,
  "engine": "InnoDB",
  "field_order": [
    "channel_type",
    "channel_name",
    "enabled",
    "section_whatsapp",
    "whatsapp_phone_number_id",
    "whatsapp_business_account_id",
    "whatsapp_access_token",
    "whatsapp_verify_token",
    "section_webhook",
    "webhook_url"
  ],
  "fields": [
    {
      "fieldname": "channel_type",
      "fieldtype": "Select",
      "label": "Channel Type",
      "options": "WhatsApp\nEmail\nSMS",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "channel_name",
      "fieldtype": "Data",
      "label": "Channel Name",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "enabled",
      "fieldtype": "Check",
      "label": "Enabled",
      "default": "1",
      "in_list_view": 1
    },
    {
      "fieldname": "section_whatsapp",
      "fieldtype": "Section Break",
      "label": "WhatsApp Configuration",
      "depends_on": "eval:doc.channel_type=='WhatsApp'"
    },
    {
      "fieldname": "whatsapp_phone_number_id",
      "fieldtype": "Data",
      "label": "Phone Number ID",
      "description": "From Meta Business Suite > WhatsApp > API Setup"
    },
    {
      "fieldname": "whatsapp_business_account_id",
      "fieldtype": "Data",
      "label": "Business Account ID"
    },
    {
      "fieldname": "whatsapp_access_token",
      "fieldtype": "Password",
      "label": "Access Token",
      "description": "Permanent or temporary token from Meta Developer Portal"
    },
    {
      "fieldname": "whatsapp_verify_token",
      "fieldtype": "Data",
      "label": "Webhook Verify Token",
      "description": "Custom string used to verify webhook subscription"
    },
    {
      "fieldname": "section_webhook",
      "fieldtype": "Section Break",
      "label": "Webhook Info"
    },
    {
      "fieldname": "webhook_url",
      "fieldtype": "Data",
      "label": "Webhook URL",
      "read_only": 1,
      "description": "Configure this URL in Meta Developer Portal"
    }
  ],
  "index_web_pages_for_search": 0,
  "is_single": 0,
  "istable": 0,
  "modified": "2026-05-01 00:00:00.000000",
  "naming_rule": "By fieldname",
  "autoname": "field:channel_name",
  "owner": "Administrator",
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1
    }
  ],
  "sort_field": "modified",
  "sort_order": "DESC",
  "track_changes": 1
}
